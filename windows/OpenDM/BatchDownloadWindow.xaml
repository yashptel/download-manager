<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenDM.BatchDownloadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenDM">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1" Padding="24">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="AllButton" Grid.Column="1" Content="Select All" Click="All_Click" />
                    <Button x:Name="NoneButton" Grid.Column="2" Content="Select None" Click="None_Click" />
                </Grid>

                <ListView x:Name="Files" MaxHeight="300" SelectionMode="None" BorderThickness="1" CornerRadius="4"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          Background="{ThemeResource ControlFillColorDefaultBrush}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:BatchItem">
                            <Grid ColumnSpacing="10" Padding="0,6" ToolTipService.ToolTip="{x:Bind Url}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox MinWidth="0" Padding="0" VerticalAlignment="Center" IsChecked="{x:Bind Chosen, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Bind Name}" />
                                <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Url}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{x:Bind Category}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Save to" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="FolderText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CategoryFoldersButton" Grid.Column="2" Content="Use Category Folders" Click="CategoryFolders_Click"
                            Visibility="Collapsed" />
                    <Button Grid.Column="3" Content="Browse&#x2026;" Click="Browse_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Padding="24" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="StartButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" />
            <Button x:Name="LaterButton" Grid.Column="1" HorizontalAlignment="Stretch" Content="Download Later" Click="Later_Click" />
            <Button Grid.Column="2" HorizontalAlignment="Stretch" Content="Cancel" Click="Cancel_Click" />
        </Grid>
    </Grid>
</Window>
