<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenDM.ProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style x:Key="FactLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>

        <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1" Padding="24">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="FileGlyph" FontSize="32" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="NameText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddressText" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="RunningPanel" Spacing="16">
                    <ProgressBar x:Name="Bar" Maximum="1" UseLayoutRounding="False" />
                    <Grid x:Name="Facts" ColumnSpacing="16" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Status" Style="{StaticResource FactLabel}" />
                        <TextBlock x:Name="StatusText" Grid.Column="1" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="Downloaded" Style="{StaticResource FactLabel}" />
                        <TextBlock x:Name="DownloadedText" Grid.Row="1" Grid.Column="1" />
                        <TextBlock Grid.Row="2" Text="Speed" Style="{StaticResource FactLabel}" />
                        <TextBlock x:Name="SpeedText" Grid.Row="2" Grid.Column="1" />
                        <TextBlock Grid.Row="3" Text="Time left" Style="{StaticResource FactLabel}" />
                        <TextBlock x:Name="TimeLeftText" Grid.Row="3" Grid.Column="1" />
                        <TextBlock Grid.Row="4" Text="Connections" Style="{StaticResource FactLabel}" />
                        <TextBlock x:Name="ConnectionsText" Grid.Row="4" Grid.Column="1" />
                    </Grid>
                    <Expander x:Name="DetailsExpander" Header="Details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Expanding="Details_Expanding" Collapsed="Details_Collapsed">
                        <StackPanel Spacing="8">
                            <Grid x:Name="SegmentMap" Height="12" SizeChanged="SegmentMap_SizeChanged"
                                  ToolTipService.ToolTip="Finished parts of the file. Each connection fills its own part." />
                            <TextBlock x:Name="ServersText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <Grid x:Name="CompletePanel" ColumnSpacing="16" RowSpacing="6" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Size" Style="{StaticResource FactLabel}" />
                    <TextBlock x:Name="SizeText" Grid.Column="1" />
                    <TextBlock Grid.Row="1" Text="Saved to" Style="{StaticResource FactLabel}" />
                    <TextBlock x:Name="SavedToText" Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid x:Name="Footer" Grid.Row="1" Padding="24" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PrimaryButton" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="Primary_Click" />
            <Button x:Name="SecondaryButton" Grid.Column="2" HorizontalAlignment="Stretch" Click="Secondary_Click" />
            <Button x:Name="CloseButton" Grid.Column="2" HorizontalAlignment="Stretch" Content="Close" Click="Close_Click" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
