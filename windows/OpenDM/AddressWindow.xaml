<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenDM.AddressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Refresh Download Address">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1" Padding="24">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="FileGlyph" FontSize="40" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="Waiting" Width="16" Height="16" IsActive="True" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <TextBlock x:Name="Heading" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock x:Name="Body" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="Address" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               IsTextSelectionEnabled="True" Visibility="Collapsed" />
                    <TextBlock x:Name="Warning" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="24" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UseButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Content="Use This Address"
                    Click="Use_Click" Visibility="Collapsed" />
            <Button x:Name="OtherButton" Grid.Column="1" HorizontalAlignment="Stretch" Content="Cancel" Click="Other_Click" />
        </Grid>
    </Grid>
</Window>

