<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenDM.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenDM"
    Title="OpenDM">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="HeaderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="NumberHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FocusSearch_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Custom title bar: the system draws the caption buttons on the right. -->
        <Grid x:Name="TitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="AppIcon" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Text="OpenDM" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False" OpenPaneLength="220"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.Resources>
                <!-- Count badges: the default text margin (4,0,4,2) crowds the digits
                     into the rounded ends and lifts them above the badge's middle. -->
                <Thickness x:Key="ValueInfoBadgeTextMargin">6,0,6,1</Thickness>
            </NavigationView.Resources>
            <Grid AllowDrop="True" DragOver="Content_DragOver" Drop="Content_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="8,4,16,4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right" Background="Transparent">
                        <AppBarButton x:Name="AddButton" Icon="Add" Label="New download" Click="Add_Click">
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="N" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>
                        <AppBarButton x:Name="ResumeButton" Icon="Play" Label="Resume" Click="Resume_Click" IsEnabled="False" />
                        <AppBarButton x:Name="PauseButton" Icon="Pause" Label="Pause" Click="Pause_Click" IsEnabled="False" />
                        <AppBarButton x:Name="RemoveButton" Icon="Delete" Label="Remove" Click="Remove_Click" IsEnabled="False" />
                        <CommandBar.SecondaryCommands>
                            <AppBarButton Label="Resume all" Click="ResumeAll_Click" />
                            <AppBarButton Label="Pause all" Click="PauseAll_Click" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                    <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" VerticalAlignment="Center"
                                    PlaceholderText="Search downloads" QueryIcon="Find" TextChanged="Search_TextChanged" />
                </Grid>

                <!-- Column widths match the item template below. -->
                <Grid Grid.Row="1" Margin="12,0,12,0" Padding="12,0,12,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NameHeader" Tag="Name" Content="Name" Click="Header_Click" Style="{StaticResource HeaderButtonStyle}" />
                    <Button x:Name="SizeHeader" Grid.Column="1" Tag="Size" Content="Size" Click="Header_Click" Style="{StaticResource NumberHeaderButtonStyle}" />
                    <Button x:Name="ProgressHeader" Grid.Column="2" Tag="Progress" Content="Progress" Click="Header_Click" Style="{StaticResource HeaderButtonStyle}" />
                    <Button x:Name="SpeedHeader" Grid.Column="3" Tag="Speed" Content="Speed" Click="Header_Click" Style="{StaticResource NumberHeaderButtonStyle}" />
                    <Button x:Name="EtaHeader" Grid.Column="4" Tag="Eta" Content="Time left" Click="Header_Click" Style="{StaticResource NumberHeaderButtonStyle}" />
                    <Button x:Name="StatusHeader" Grid.Column="5" Tag="Status" Content="Status" Click="Header_Click" Style="{StaticResource HeaderButtonStyle}" />
                </Grid>

                <ListView x:Name="Table" Grid.Row="2" Padding="12,0,12,12" SelectionMode="Extended"
                          SelectionChanged="Table_SelectionChanged" PreviewKeyDown="Table_PreviewKeyDown"
                          ContextRequested="Table_ContextRequested" DoubleTapped="Table_DoubleTapped">
                    <!-- Rows realized off-screen keep their bindings and redraw on every
                         progress tick, and a large cache also made fast scrolling stutter. -->
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel CacheLength="1" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <!-- No reorder or add/delete animations: rows move on every tick
                         while sorted by speed or time left. -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,0,12,0" />
                            <Setter Property="MinHeight" Value="36" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DownloadItem">
                            <Grid Height="36" ColumnSpacing="12" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="160" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="10" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Url}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <!-- x:Phase="1": while scrolling fast, icon and name come first and the
                                     other columns follow over the next frames. -->
                                <TextBlock Grid.Column="1" x:Phase="1" Text="{x:Bind SizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <Grid Grid.Column="2" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Drawn like the Fluent ProgressBar. A ProgressBar re-runs its
                                         template and visual states on every value change, which made
                                         each progress tick cost about 1 ms per visible row. Scaling
                                         the indicator needs no layout. -->
                                    <!-- The top margin moves the bar down 1 px to the middle of the
                                         digits beside it; text sits low in its line box. -->
                                    <Grid Height="3" Margin="0,2,0,0" VerticalAlignment="Center" Visibility="{x:Bind IsDeterminate, Mode=OneWay}">
                                        <!-- Not rounded to whole pixels: at 125% and 150% a rounded 1 px track
                                             sits half a pixel above the middle of the 3 px indicator. -->
                                        <Rectangle Height="1" VerticalAlignment="Center" RadiusX="0.5" RadiusY="0.5" UseLayoutRounding="False"
                                                   Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                        <Grid>
                                            <Grid.RenderTransform>
                                                <ScaleTransform ScaleX="{x:Bind Fraction, Mode=OneWay}" />
                                            </Grid.RenderTransform>
                                            <Rectangle RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                       Visibility="{x:Bind IsRunningOrDone, Mode=OneWay}" />
                                            <Rectangle RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource SystemFillColorCautionBrush}"
                                                       Visibility="{x:Bind IsPaused, Mode=OneWay}" />
                                            <Rectangle RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                                       Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                                        </Grid>
                                    </Grid>
                                    <ProgressBar x:Name="Busy" x:Load="{x:Bind IsIndeterminate, Mode=OneWay}" IsIndeterminate="True"
                                                 Margin="0,2,0,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Phase="1" Text="{x:Bind PercentText, Mode=OneWay}" HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <TextBlock Grid.Column="3" x:Phase="1" Text="{x:Bind SpeedText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" x:Phase="1" Text="{x:Bind EtaText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" x:Phase="1" Text="{x:Bind StatusText, Mode=OneWay}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Visibility="{x:Bind IsNotFailed, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="5" x:Phase="1" Text="{x:Bind StatusText, Mode=OneWay}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Visibility="{x:Bind IsFailed, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
