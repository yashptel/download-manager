<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenDM.DownloadInfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Download File Info">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1" Padding="24">
            <StackPanel Spacing="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="FileGlyph" FontSize="40" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="Heading" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="Checking" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="Summary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="NameBox_TextChanged" />

                    <TextBlock Grid.Row="1" Text="Category" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CategoryBox" Grid.Row="1" Grid.Column="1" MinWidth="200" SelectionChanged="CategoryBox_SelectionChanged" />

                    <TextBlock Grid.Row="2" Text="Save to" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="Browse&#x2026;" Click="Browse_Click" />
                    </Grid>

                    <CheckBox x:Name="RememberBox" Grid.Row="3" Grid.Column="1" Visibility="Collapsed" />

                    <TextBlock x:Name="QualityLabel" Grid.Row="4" Text="Quality" Style="{StaticResource FieldLabel}" Visibility="Collapsed" />
                    <TextBlock x:Name="QualityText" Grid.Row="4" Grid.Column="1" Visibility="Collapsed" />

                    <TextBlock Grid.Row="5" Text="Address" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="AddressText" Grid.Row="5" Grid.Column="1" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Padding="24" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="StartButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Content="Start Download" Click="Start_Click" />
            <Button Grid.Column="1" HorizontalAlignment="Stretch" Content="Download Later" Click="Later_Click" />
            <Button Grid.Column="2" HorizontalAlignment="Stretch" Content="Cancel" Click="Cancel_Click" />
        </Grid>
    </Grid>
</Window>
